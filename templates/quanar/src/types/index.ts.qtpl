/** Where a quan is served from. */
export interface QuanConfig {
  name: string;
  url: string;
}
[[- if not .Quas ]]

/** A quan's manifest. A qua normally provides this type; this [[ .Kind ]] has none yet. */
export interface QuanManifest {
  name: string;
  version: string;
  displayName?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  routes: { path: string; component: any; permission?: string }[];
  permissions: string[];
  onMount?: () => void | Promise<void>;
}
[[- end ]]
