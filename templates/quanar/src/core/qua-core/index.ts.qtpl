[[ range .Quas ]]import * as [[ pascal .Name ]] from '[[ .Name ]]';
[[ end ]]// qu:qua-imports

/**
[[- if eq .Kind "qmock" ]]
 * Stand-in implementations of the quas, for developing quans. The real ones
 * live in the quanar; these only need to be good enough to work against.
[[- else ]]
 * The quanar's side of each qua: the real implementation behind every call a
 * quan makes.
[[- end ]]
 *
 * Lines marked "qu:" are where `qu` adds a qua when a new quan brings one.
 */
[[ range .Quas ]]const [[ camel .Name ]]Core: [[ pascal .Name ]].QuanarCore = {
  increment: (value) => value + 1,
};

[[ end ]]// qu:qua-cores

/** Plugs every core into its qua. Called once, before any quan is loaded. */
export function initQua(): void {
[[- range .Quas ]]
  if ([[ pascal .Name ]].isInitialized()) [[ pascal .Name ]].reset();
  [[ pascal .Name ]].init([[ camel .Name ]]Core);
[[- end ]]
  // qu:qua-init
}
