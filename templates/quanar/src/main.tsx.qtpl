import React from 'react';
import * as ReactDOM from 'react-dom/client';
import * as jsxRuntime from 'react/jsx-runtime';
[[ range .Quas ]]import * as [[ pascal .Name ]] from '[[ .Name ]]';
[[ end ]]// qu:qua-imports
import { initQua } from './core';
import { App } from './App';

// Quans do not bundle these: they use the [[ .Kind ]]'s copies from window.
// Lines marked "qu:" are where `qu` adds a qua when a new quan brings one.
declare global {
  interface Window {
    React: typeof React;
    ReactDOM: typeof ReactDOM;
    ReactJSXRuntime: typeof jsxRuntime;
[[- range .Quas ]]
    [[ pascal .Name ]]: typeof [[ pascal .Name ]];
[[- end ]]
    // qu:qua-window-types
  }
}

window.React = React;
window.ReactDOM = ReactDOM;
window.ReactJSXRuntime = jsxRuntime;
[[ range .Quas ]]window.[[ pascal .Name ]] = [[ pascal .Name ]];
[[ end ]]// qu:qua-window

// Plug the cores into the quas before any quan is loaded.
initQua();

ReactDOM.createRoot(document.getElementById('root')!).render(<App />);
