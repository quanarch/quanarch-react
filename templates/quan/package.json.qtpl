{
  "name": "[[ .Name ]]",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build && vite preview --port [[ .Port ]]",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
[[- range $i, $q := .Quas ]][[ if $i ]],[[ end ]]
    "[[ $q.Name ]]": "file:[[ $q.Path ]]"
[[- end ]]
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
