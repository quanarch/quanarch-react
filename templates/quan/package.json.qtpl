{
  "name": "[[ .Name ]]",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "deliver": "node scripts/deliver.mjs"
  },
  "dependencies": {
[[ range .Quas ]]    "[[ .Name ]]": "[[ if .Path ]]file:[[ .Path ]][[ else if .Version ]]^[[ .Version ]][[ else ]]*[[ end ]]",
[[ end ]]    "@quanarch/react": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
