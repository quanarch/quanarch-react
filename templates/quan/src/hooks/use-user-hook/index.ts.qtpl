[[ if .Quas ]][[ $qua := index .Quas 0 ]]import { useEffect, useState } from 'react';
import { useQua } from '@quanarch/react';
import { [[ camel $qua.Name ]], type User } from '[[ $qua.Name ]]';

/** The signed-in user, asked of the quanar through [[ $qua.Name ]]. */
export function useUser() {
  const qua = useQua([[ camel $qua.Name ]]);
  const [user, setUser] = useState<User>();

  useEffect(() => {
    qua.getUser().then(setUser);
  }, [qua]);

  return { user, notify: qua.notify };
}
[[ else ]]/**
 * The signed-in user. This quan uses no qua yet, so there is no quanar to ask:
 * wire one in with `--qua` and read the user through it.
 */
export function useUser() {
  return { user: undefined as { name: string } | undefined, notify: (message: string) => console.info(message) };
}
[[ end ]]