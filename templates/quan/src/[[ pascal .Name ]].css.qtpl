.[[ .Name ]] {
  max-width: 40rem;
  padding: 1.5rem;
  border: 1px solid #e4e1ec;
  border-radius: 10px;
  background: #fff;
}

.[[ .Name ]] h1 {
  margin: 0 0 0.5rem;
  font-size: 1.4rem;
}

.[[ .Name ]] button {
  font: inherit;
  padding: 0.4rem 0.9rem;
  border: 0;
  border-radius: 6px;
  background: #1d1b26;
  color: #fff;
  cursor: pointer;
}
