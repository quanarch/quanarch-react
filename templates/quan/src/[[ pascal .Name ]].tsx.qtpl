[[ if .Quas ]][[ $qua := index .Quas 0 ]]import { useEffect, useState } from 'react';
import { useQua } from '@quanarch/react';
import { [[ camel $qua.Name ]], type User } from '[[ $qua.Name ]]';
import './[[ pascal .Name ]].css';

export function [[ pascal .Name ]]() {
  const qua = useQua([[ camel $qua.Name ]]);
  const [user, setUser] = useState<User>();

  useEffect(() => {
    qua.getUser().then(setUser);
  }, [qua]);

  return (
    <section className="[[ .Name ]]">
      <h1>[[ title .Name ]]</h1>
      <p>{user ? `Signed in as ${user.name}.` : 'Loading…'}</p>
      <button onClick={() => qua.notify('Hello from [[ .Name ]]')}>Say hello</button>
    </section>
  );
}
[[ else ]]import { useState } from 'react';
import './[[ pascal .Name ]].css';

export function [[ pascal .Name ]]() {
  const [count, setCount] = useState(0);

  return (
    <section className="[[ .Name ]]">
      <h1>[[ title .Name ]]</h1>
      <p>This quan uses no quas yet. Add one with a qua and useQua().</p>
      <button onClick={() => setCount((c) => c + 1)}>Clicked {count} times</button>
    </section>
  );
}
[[ end ]]