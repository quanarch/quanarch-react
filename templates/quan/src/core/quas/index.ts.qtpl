import type { Qua } from '@quanarch/react';
[[ range .Quas ]]import { [[ camel .Name ]] } from '[[ .Name ]]';
[[ end ]]
/**
 * Every qua this quan uses. The quanar must plug in each of them; the quan can
 * reach nothing else.
 */
export const quas: Qua<unknown>[] = [
[[- range .Quas ]]
  [[ camel .Name ]],
[[- end ]]
[[- if .Quas ]]
[[ end ]]];
