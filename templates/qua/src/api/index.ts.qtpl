import type { User } from '../types';

/**
 * What a quan can ask of its quanar through [[ .Name ]].
 *
 * This is the whole contract: quans see only these methods, and the quanar
 * decides how each one works. Change it freely until the first release; after
 * that, breaking changes belong in a new version of the qua.
 */
export interface [[ pascal .Name ]] {
  /** Returns the signed-in user. */
  getUser(): Promise<User>;
  /** Shows a message to the user. */
  notify(message: string): void;
}
