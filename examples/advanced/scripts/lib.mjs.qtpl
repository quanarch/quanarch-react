// Shared by the setup, build, start and clean scripts.
import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

export const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
export const QUA_DIR = path.join(ROOT, 'packages', '[[ .Name ]]-qua');
export const ARTIFACTS_URL = process.env.ARTIFACTS_URL ?? 'http://localhost:4100';

/**
 * The four quans and where each build goes.
 * - registered: listed in the server's quans table; its build is hashed into it.
 * - target: "artifacts" (the artifact store) or "quanar-public" (the quanar's public folder).
 */
export const QUANS = [
  { name: 'billing', delivery: 'api', registered: true, target: 'artifacts' },
  { name: 'inventory', delivery: 'sse', registered: true, target: 'artifacts' },
  { name: 'reports', delivery: 'public', registered: false, target: 'quanar-public' },
  { name: 'analytics', delivery: 'artifacts', registered: false, target: 'artifacts' },
];

const COLORS = { server: 36, artifacts: 35, quanar: 33, build: 32, setup: 34 };

export function log(tag, message) {
  const color = COLORS[tag] ?? 37;
  for (const line of String(message).split('\n')) {
    if (line.trim()) console.log(`\x1b[${color}m[${tag}]\x1b[0m ${line}`);
  }
}

/** Runs a command and resolves when it exits successfully. */
export function run(command, args, cwd, tag, env = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, { cwd, env: { ...process.env, ...env }, shell: process.platform === 'win32' });
    child.stdout.on('data', (d) => log(tag, d));
    child.stderr.on('data', (d) => log(tag, d));
    child.on('error', reject);
    child.on('exit', (code) => (code === 0 ? resolve() : reject(new Error(`${command} ${args.join(' ')} failed in ${cwd}`))));
  });
}
