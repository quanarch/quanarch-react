import { http } from '[[ .Name ]]-qua';
import { API_ENDPOINTS } from '../constants';
import type { ActionResult, Report } from '../types';

/** Requests to the server, made with the quanar's client through the qua. */
export async function getReports(): Promise<Report[]> {
  return http.get<Report[]>(API_ENDPOINTS.REPORTS);
}

export async function summarize(): Promise<ActionResult> {
  return http.post<ActionResult>(API_ENDPOINTS.SUMMARY);
}
