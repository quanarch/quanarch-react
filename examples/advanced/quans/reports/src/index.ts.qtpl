import type { QuanManifest } from '[[ .Name ]]-qua';
import { ReportsPage } from './pages';
import { PERMISSIONS, QUAN_NAME, ROUTES } from './constants';

const manifest: QuanManifest = {
  name: QUAN_NAME,
  version: '1.0.0',
  displayName: 'Reports',
  description: 'Monthly reports.',
  routes: [{ path: ROUTES.HOME, component: ReportsPage, permission: PERMISSIONS.READ }],
  permissions: Object.values(PERMISSIONS),
};

export { manifest };
export default manifest;
