import type { QuanManifest } from '[[ .Name ]]-qua';
import { AnalyticsPage } from './pages';
import { PERMISSIONS, QUAN_NAME, ROUTES } from './constants';

const manifest: QuanManifest = {
  name: QUAN_NAME,
  version: '1.0.0',
  displayName: 'Analytics',
  description: 'Traffic and conversion.',
  routes: [{ path: ROUTES.HOME, component: AnalyticsPage, permission: PERMISSIONS.READ }],
  permissions: Object.values(PERMISSIONS),
};

export { manifest };
export default manifest;
